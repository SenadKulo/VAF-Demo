<Project Sdk="Microsoft.NET.Sdk">

  <!-- What Visual Studio's NUnit Test Project template creates (.NET 10, NUnit 4), plus VAF.
       For .NET Framework, set <TargetFramework>net472</TargetFramework>; nothing else changes. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VAF_Demo</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="VisionAutomationFramework" Version="3.0.0-beta.2" />
  </ItemGroup>

</Project>
